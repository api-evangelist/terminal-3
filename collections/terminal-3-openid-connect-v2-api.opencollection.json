{
  "opencollection": "1.0.0",
  "info": {
    "name": "Terminal 3 DID V1 OpenID Connect V2 API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OpenID Connect V2",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenID Connect token endpoint (v2)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.terminal3.io/v2/openidc/token"
          },
          "docs": "OpenID Connect token endpoint (v2)"
        },
        {
          "info": {
            "name": "OpenID Connect userinfo endpoint (v2)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.terminal3.io/v2/openidc/user"
          },
          "docs": "OpenID Connect userinfo endpoint (v2)"
        }
      ]
    }
  ],
  "bundled": true
}